---
import Layout from "../layouts/default.astro";
import ExternalLink from "../components/external_link.astro";
import faq from "../data/faq.yaml";
import socials from "../data/socials.yaml";
import tools from "../data/tools.yaml";

type Social = keyof typeof socials;

type FAQ = {
  question: string;
  answer: string;
  link?: {
    label: string;
    social: Social;
  };
};

type Tool = {
  name: string;
  description: string;
  link: string;
};

const questions: FAQ[] = faq;
const toolList = tools as Tool[];

const toolDomain = (link: string) => new URL(link).hostname.replace(/^www\./, "");
---

<Layout
  title="About | VFTF"
  description="About Vanilla Fortress">

  <section class="page-intro">
    <h1>About</h1>
    <p class="page-lead">
      Vanilla Fortress is a community hub for finding and seeding vanilla TF2 servers
      reminiscent of the Quickplay era.
    </p>
    <p class="page-lead">Get notifications for sessions on our Discord server and Steam group!</p>
    <div class="links">
      <ExternalLink href={socials.discord}>Discord Server</ExternalLink>
      <ExternalLink href={socials.steam}>Steam Group</ExternalLink>
      <a href="/">Server List</a>
    </div>
  </section>

  <div class="about-columns">

    <section class="faq-list" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">FAQ</h2>
      {questions.map((item) => (
        <article class="question">
          <h3>{item.question}</h3>
          <p>
            {item.answer}
            {item.link && (
              <> <ExternalLink href={socials[item.link.social]}>{item.link.label}</ExternalLink>.</>
            )}
          </p>
        </article>
      ))}
    </section>

    <section class="faq-list tools-list" id="tools" aria-labelledby="tools-title">
      <h2 id="tools-title">QOL Tools</h2>
      <p class="section-note">A collection of quality of life tools and mods for TF2.</p>
      {toolList.map((item) => (
        <article class="question">
          <h3>{item.name}</h3>
          <p>{item.description}</p>

          <div class="links">
            <ExternalLink href={item.link}>Open<span class="visually-hidden"> {item.name}</span></ExternalLink>
            <span class="tool-domain">{toolDomain(item.link)}</span>
          </div>
        </article>
      ))}
    </section>

  </div>

</Layout>
